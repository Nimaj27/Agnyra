// ============================================================
// firestore.rules — Belenos
// Chantier multi-tenant, points 4 (volet admin) et 6 (migration)
// ============================================================
//
// Périmètre de ce fichier à ce stade :
//   - organisations : lecture ouverte à toute session (même anonyme —
//     nécessaire à l'identification de la caserne à la connexion,
//     chantier 3, avant même de savoir si l'utilisateur est admin ou
//     équipier) ; écriture réservée à l'admin de CETTE caserne (un admin
//     ne peut plus modifier une organisation qui n'est pas la sienne),
//     ou à un super-admin plateforme (superAdmin:true sur son document
//     admins/{email}) pour créer/gérer n'importe quelle caserne — c'est
//     lui qui onboarde une nouvelle amicale sur la plateforme
//   - admins : un utilisateur connecté peut lire uniquement SON PROPRE
//     document (nécessaire pour isAdmin()/obtenirOrganisationAdmin()),
//     pas la collection entière
//   - equipes/secteurs/passages/pins : lecture/écriture réservées à
//     l'admin de la caserne concernée (organisationId du document) ou à
//     un super-admin — nécessaire pour que le script de migration
//     (scripts/migration-pacy-vers-belenos.html) puisse écrire les
//     données copiées depuis calendrier-pacy
//   - config/journal : réservés à un admin authentifié (n'importe lequel :
//     ces deux collections ne portent pas encore d'organisationId, elles
//     restent globales pour l'instant — à revoir si elles doivent un jour
//     être scindées par caserne)
//   - tout le reste : refusé par défaut
//
// Volontairement hors périmètre pour l'instant : l'accès équipier (sessions
// anonymes via code PIN) à equipes/secteurs/passages/pins. Une session
// anonyme ne porte aucune information de caserne dans son jeton
// d'authentification — un cloisonnement robuste demanderait une Cloud
// Function qui vérifie le PIN côté serveur et émet un jeton avec
// organisationId/equipeId en claims (code prêt, voir functions/, non
// déployé — nécessite le plan Blaze). Tant que ce n'est pas fait, l'écran
// de connexion équipier de l'app reste inopérant sur ce projet ; seul
// l'accès admin est câblé ici.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Caserne administrée par l'admin connecté. Reflète le repli côté
    // client (obtenirOrganisationAdmin() dans firebase.js) : à défaut de
    // champ organisationId sur son document admins/{email}, on retombe
    // sur "pacy" (chantier multi-tenant, point 3). À garder synchronisé
    // avec ORGANISATION_ACTUELLE tant que ce TODO n'est pas résolu.
    // N'est appelée que lorsque estAdmin() est déjà vrai (court-circuit
    // du &&), donc le document admins/{email} existe forcément ici.
    function organisationIdAdmin() {
      return get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.get('organisationId', 'pacy');
    }

    // Super-admin plateforme : gère l'onboarding des casernes, pas les
    // données d'une caserne en particulier. Absent par défaut (false) —
    // seuls les comptes qui portent explicitement superAdmin:true le sont.
    function estSuperAdmin() {
      return estAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())).data.get('superAdmin', false) == true;
    }

    match /admins/{email} {
      allow read: if request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email;
    }

    match /organisations/{slug} {
      allow read: if request.auth != null;
      allow write: if estSuperAdmin() || (estAdmin() && organisationIdAdmin() == slug);
    }

    // Admin de la caserne du document (ou super-admin), pour les
    // collections qui portent un organisationId (chantier multi-tenant,
    // point 2). Un admin ne voit/modifie que les données de sa caserne.
    function peutAdministrerOrganisation(orgId) {
      return estSuperAdmin() || (estAdmin() && organisationIdAdmin() == orgId);
    }

    // Un admin ne peut ni lire/modifier/supprimer un document d'une autre
    // caserne, ni en changer l'organisationId lors d'une mise à jour (ce
    // qui reviendrait à le faire changer de caserne).
    function accesDocumentOrganisation() {
      return resource.data.organisationId != null
        && peutAdministrerOrganisation(resource.data.organisationId);
    }
    function miseAJourSansChangerOrganisation() {
      return accesDocumentOrganisation()
        && request.resource.data.organisationId == resource.data.organisationId;
    }

    // "list" (lecture de collection, avec ou sans filtre) reste ouvert à
    // tout admin pour l'instant : l'app lit ces collections sans filtre
    // organisationId (fsGetAll/fsListen non scopés), et Firestore rejette
    // en bloc toute requête de liste dont le filtre ne correspond pas
    // exactement au champ utilisé par la règle — même si chaque document
    // retourné la validerait individuellement. Cloisonner "list" demande
    // de revoir tous ces appels pour leur ajouter where("organisationId",
    // "==", ...), un chantier à part entière. Sans risque tant qu'une
    // seule caserne est active (même raisonnement que le volet équipier).
    // "get" (lecture d'un document précis par ID) n'a pas cette
    // contrainte et reste cloisonné dès maintenant.
    match /equipes/{id} {
      allow get, delete: if accesDocumentOrganisation();
      allow list: if estAdmin();
      allow update: if miseAJourSansChangerOrganisation();
      allow create: if peutAdministrerOrganisation(request.resource.data.organisationId);
    }
    match /secteurs/{id} {
      allow get, delete: if accesDocumentOrganisation();
      allow list: if estAdmin();
      allow update: if miseAJourSansChangerOrganisation();
      allow create: if peutAdministrerOrganisation(request.resource.data.organisationId);
    }
    match /passages/{id} {
      allow get, delete: if accesDocumentOrganisation();
      allow list: if estAdmin();
      allow update: if miseAJourSansChangerOrganisation();
      allow create: if peutAdministrerOrganisation(request.resource.data.organisationId);
    }
    match /pins/{id} {
      allow get, delete: if accesDocumentOrganisation();
      allow list: if estAdmin();
      allow update: if miseAJourSansChangerOrganisation();
      allow create: if peutAdministrerOrganisation(request.resource.data.organisationId);
    }

    // Pas encore scindés par caserne (voir note en tête de fichier).
    match /config/{id} {
      allow read, write: if estAdmin();
    }
    match /journal/{id} {
      allow read, write: if estAdmin();
    }

    // Refus par défaut pour toute collection non explicitement autorisée
    // ci-dessus.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
